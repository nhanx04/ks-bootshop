<ul class="nav-desktop-menu nav justify-content-center">
  {% for link in linklists[block.settings.main_menu].links %}
    {% assign is_products_link = false %}
    {% assign is_collections_link = false %}
    {% if link.type == 'catalog_link' or link.url == routes.all_products_collection_url %}
      {% assign is_products_link = true %}
    {% endif %}
    {% if link.type == 'collections_link' or link.url == routes.collections_url %}
      {% assign is_collections_link = true %}
    {% endif %}
    {% assign is_mega_active = false %}
    {% if link.active or link.child_active %}
      {% assign is_mega_active = true %}
    {% elsif is_products_link and template.name == 'product' %}
      {% assign is_mega_active = true %}
    {% elsif is_collections_link and template.name == 'collection' and request.path != routes.all_products_collection_url %}
      {% assign is_mega_active = true %}
    {% endif %}

    {% if is_products_link or is_collections_link %}
      <li class="nav-item navbar-mega-item">
        <div class="navbar-mega-trigger {% if is_mega_active %}active{% endif %}">
          <a class="nav-link {% if is_mega_active %}active{% endif %}"
            href="{% if is_products_link %}{{ routes.all_products_collection_url }}{% else %}{{ routes.collections_url }}{% endif %}">
            {{ link.title | escape }}
          </a>
          <button class="navbar-mega-toggle" type="button"
            aria-label="Open {{ link.title | escape }} menu"
            aria-expanded="false" aria-controls="navbar-mega-{{ forloop.index }}">
            <svg aria-hidden="true" viewBox="0 0 12 8" fill="none" focusable="false">
              <path d="m1 1 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        <div class="navbar-mega-panel" id="navbar-mega-{{ forloop.index }}">
          <div class="navbar-mega-inner">
            {% if is_products_link %}
              {% if link.links != blank %}
                <div class="navbar-mega-categories">
                  {% for child_link in link.links %}
                    <div class="navbar-mega-category">
                      <a class="navbar-mega-category-title" href="{{ child_link.url }}">{{ child_link.title | escape }}</a>
                      {% if child_link.links != blank %}
                        <ul>
                          {% for grandchild_link in child_link.links %}
                            <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title | escape }}</a></li>
                          {% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
              <a class="navbar-mega-view-all" href="{{ routes.all_products_collection_url }}">View all products <span aria-hidden="true">›</span></a>
            {% else %}
              <div class="navbar-mega-collections">
                {% if block.settings.featured_collections != blank %}
                  {% for featured_collection in block.settings.featured_collections limit: 3 %}
                    {% render 'navbar-collection-card', collection: featured_collection %}
                  {% endfor %}
                {% else %}
                  {% for featured_collection in collections limit: 3 %}
                    {% render 'navbar-collection-card', collection: featured_collection %}
                  {% endfor %}
                {% endif %}
              </div>
              <a class="navbar-mega-view-all" href="{{ routes.collections_url }}">View all collections <span aria-hidden="true">›</span></a>
            {% endif %}
          </div>
        </div>
      </li>
    {% else %}
      <li class="nav-item {% if link.links %}dropdown{% endif %}">
        {% if link.links == blank %}
          <a class="nav-link {% if link.active %}active{% endif %}"
            href="{{ link.url }}"
            aria-current="{% if link.active %}page{% endif %}">
            {{ link.title }}
          </a>
        {% else %}
          <a class="nav-link dropdown-toggle {% if link.child_active %}active{% endif %}"
            href="#" data-bs-toggle="dropdown" data-bs-display="static"
            aria-expanded="false" role="button">
            {{ link.title }}
          </a>
          <ul class="dropdown-menu">
            {% for child_link in link.links %}
              <li>
                {% if child_link.title == '-' %}
                  <hr class="dropdown-divider">
                {% else %}
                  <a class="dropdown-item {% if child_link.active %}active{% endif %}"
                    href="{{ child_link.url }}"
                    aria-current="{% if child_link.active %}page{% endif %}">
                    {{ child_link.title }}
                  </a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endif %}
  {% endfor %}
</ul>
