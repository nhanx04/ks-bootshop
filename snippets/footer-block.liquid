{% case block.type %}
  {% when 'richtext' %}
    {% if block.settings.show_logo %}
      {% assign footer_logo = block.settings.logo | default: settings.logo | default: shop.brand.logo %}
      <a class="footer-about-logo d-inline-block mb-5" href="{{ routes.root_url }}" style="width: {{ block.settings.logo_width | default: 180 }}px; max-width: 100%;">
        {% if footer_logo != blank %}
          <img
            src="{{ footer_logo | image_url: width: 640 }}"
            alt="{{ shop.name | escape }}"
            width="{{ footer_logo.width }}"
            height="{{ footer_logo.height }}"
            class="img-fluid"
            loading="lazy">
        {% else %}
          <span class="fs-xxl">{{ shop.name | escape }}</span>
        {% endif %}
      </a>
    {% endif %}
    {% unless block.settings.description == blank %}
      <div class="description rte mt-2 mb-6">
        {{ block.settings.description }}
      </div>
    {% endunless %}
    {% unless block.settings.btn_primary_text == blank %}
      <div class="m-n2">
        {% unless block.settings.btn_primary_text == blank %}
          <a 
            class="btn btn-sm m-2 {{ block.settings.btn_primary_color }}" 
            href="{{ block.settings.btn_primary_url }}">
            {{ block.settings.btn_primary_text }}
          </a>
        {% endunless %}
        {% unless block.settings.btn_secondary_text == blank %}
          <a 
            class="btn btn-sm m-2 {{ block.settings.btn_secondary_color }}" 
            href="{{ block.settings.btn_secondary_url }}">
            {{ block.settings.btn_secondary_text }}
          </a>
        {% endunless %}
      </div>
    {% endunless %}
    {% if block.settings.show_social_icons %}
      <div class="footer-about-social mt-5">
        {% render 'social-icons', icon_size: 20, show_title: false %}
      </div>
    {% endif %}
  {% when 'menu' %}
    <ul 
      class="nav flex-column mb-0" 
      aria-label="{{ block.settings.title }}">
      {% for link in linklists[block.settings.menu].links %}
        <li class="nav-item">
          <a 
            class="nav-link px-0 px-desktop-3 py-3 py-desktop-2" 
            href="{{ link.url }}">
            {{ link.title }}
          </a>
        </li>
      {% endfor %}
    </ul>
{% endcase %}
