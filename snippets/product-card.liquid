{% comment %}
  Renders a product card in product lists and featured product sections.
{% endcomment %}

{% assign product_url = product.url | within: collection %}
<div class="product-card {{ settings.product_card_text_align }}">
  <div class="product-card-img-wrapper">
    <a href="{{ product_url }}" class="product-card-image-link" aria-label="{{ product.title | escape }}">
      {% unless product.available %}
        <span class="product-sold-out-badge badge">{{ 'product.sold_out' | t }}</span>
      {% else %}
        {% if product.compare_at_price > product.price %}
          <span class="product-sale-badge badge" data-discount-type="{{ settings.product_card_badge_discount_type }}">
            {% if settings.product_card_badge_discount_type == 'percentage' %}
              {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round | prepend: '-' | append: '%' }}
            {% else %}
              {{ 'product.save' | t }} {{ product.compare_at_price | minus: product.price | money_without_trailing_zeros }}
            {% endif %}
          </span>
        {% endif %}
      {% endunless %}
      {% render 'image-url', img: product.featured_image, orientation: 'ratio-1x1', class: settings.product_card_img_border %}
    </a>
    <div class="product-card-actions">
      {% if settings.product_card_show_atc_form and product.available %}
        {% render 'product-card-form', product: product, compact: true %}
      {% endif %}
      <a class="product-card-view" href="{{ product_url }}" aria-label="View {{ product.title | escape }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
      </a>
    </div>
  </div>
  <a href="{{ product_url }}" class="product-card-link">
    <h3 class="product-card-title product-title {{ settings.product_card_title_font_size }}">{{ product.title }}</h3>
    {% render 'product-card-price', product: product %}
  </a>
  {% for option in product.options_with_values %}
    {% assign option_name = option.name | downcase %}
    {% if option_name contains 'color' or option_name contains 'colour' or option_name contains 'màu' %}
      <div class="product-card-color-swatches" aria-label="{{ option.name | escape }}">
        {% for option_value in option.values limit: 5 %}
          {% assign swatch_variant = option_value.variant | default: product.selected_or_first_available_variant %}
          {% assign swatch_image = option_value.swatch.image | default: swatch_variant.featured_image %}
          {% assign swatch_url = option_value.product_url | default: product_url %}
          <a class="product-card-swatch{% if option_value.selected %} is-selected{% endif %}" href="{{ swatch_url }}{% unless option_value.product_url %}?variant={{ swatch_variant.id }}{% endunless %}" title="{{ option_value.name | escape }}" aria-label="{{ option.name | escape }}: {{ option_value.name | escape }}" {% if option_value.swatch.color %}style="--swatch-color: {{ option_value.swatch.color | escape }}"{% endif %}>
            {% if swatch_image %}
              <img src="{{ swatch_image | image_url: width: 60, height: 60, crop: 'center' }}" alt="" width="28" height="28" loading="lazy">
            {% elsif option_value.swatch.color %}
              <span class="product-card-swatch-color"></span>
            {% else %}
              <span class="product-card-swatch-label">{{ option_value.name | slice: 0, 1 }}</span>
            {% endif %}
          </a>
        {% endfor %}
        {% if option.values.size > 5 %}<span class="product-card-swatch-more">+{{ option.values.size | minus: 5 }}</span>{% endif %}
      </div>
      {% break %}
    {% endif %}
  {% endfor %}
</div>
