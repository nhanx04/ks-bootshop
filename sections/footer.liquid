{% assign footer_logo = section.settings.logo | default: settings.logo | default: shop.brand.logo %}

<footer id="footer" class="{{ section.settings.bg_color }} {{ section.settings.bg_gradient }} {{ section.settings.text_color }} {{ section.settings.pt | prepend: 'pt-' }} {{ section.settings.pb | prepend: 'pb-' }}">
  <div class="container">
    <div class="footer-main">
      <div class="footer-signup">
        <h2 class="footer-heading footer-signup-heading">Stay Connected</h2>
        <p class="footer-signup-intro">Leave your details and our team will get in touch.</p>
        {% form 'contact', class: 'footer-signup-form' %}
          {% if form.posted_successfully? %}
            <div class="footer-form-success" role="status">Thanks! We have received your details.</div>
          {% endif %}
          {% if form.errors %}
            <div class="footer-form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <input type="hidden" name="contact[body]" value="Footer signup request">
          <div class="footer-form-grid">
            <div class="footer-form-field">
              <label for="footer-name-{{ section.id }}">Name <span aria-hidden="true">*</span></label>
              <input id="footer-name-{{ section.id }}" class="form-control" type="text" name="contact[name]" value="{{ form.name | default: customer.name | escape }}" placeholder="Jane Doe" autocomplete="name" required>
            </div>
            <div class="footer-form-field">
              <label for="footer-email-{{ section.id }}">E-Mail Address <span aria-hidden="true">*</span></label>
              <input id="footer-email-{{ section.id }}" class="form-control" type="email" name="contact[email]" value="{{ form.email | default: customer.email | escape }}" placeholder="example@gmail.com" autocomplete="email" required>
            </div>
            <div class="footer-form-field">
              <label for="footer-phone-{{ section.id }}">Phone Number</label>
              <input id="footer-phone-{{ section.id }}" class="form-control" type="tel" name="contact[phone]" value="{{ customer.phone | escape }}" placeholder="(555) 555-1234" autocomplete="tel">
            </div>
            <button class="btn btn-primary footer-submit" type="submit">Send Details</button>
          </div>
          <p class="footer-form-privacy">We will only use your details to respond to your request.</p>
        {% endform %}
      </div>

      <nav class="footer-service" aria-label="Customer Service">
        <h2 class="footer-heading">Customer Service</h2>
        <ul class="footer-link-list">
          <li><a href="/pages/about-us">About</a></li>
          <li><a href="/pages/our-story">Our Story</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/shipping-delivery">Shipping &amp; Delivery</a></li>
          <li><a href="/pages/returns-refunds">Returns &amp; Refunds</a></li>
          <li><a href="/pages/order-tracking">Order Tracking</a></li>
        </ul>
      </nav>

      <nav class="footer-collections" aria-label="Collections">
        <h2 class="footer-heading">Collections</h2>
        {% if section.settings.collection_menu != blank %}
          <ul class="footer-link-list">
            {% for link in linklists[section.settings.collection_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>

      <div id="contact-follow-us" class="footer-contact">
        <h2 class="footer-heading footer-contact-heading">Contact &amp; Follow Us</h2>
        <ul class="footer-link-list footer-contact-list">
          <li><a href="mailto:{{ section.settings.contact_email | escape }}">{% render 'footer-contact-icon', icon: 'mail' %}<span>{{ section.settings.contact_email | escape }}</span></a></li>
          <li><a href="https://www.facebook.com/profile.php?id=61592741266067" target="_blank" rel="noopener noreferrer">{% render 'footer-contact-icon', icon: 'facebook' %}<span>Facebook</span></a></li>
          <li><a href="https://www.instagram.com/lurevo.studio/" target="_blank" rel="noopener noreferrer">{% render 'footer-contact-icon', icon: 'instagram' %}<span>Instagram</span></a></li>
          <li><a href="https://www.threads.com/@lurevo.studio" target="_blank" rel="noopener noreferrer">{% render 'footer-contact-icon', icon: 'threads' %}<span>Threads</span></a></li>
        </ul>
      </div>
    </div>

    <div id="footer-copyright">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.</p>
      {% if section.settings.show_payment_icons %}
        {% render 'payment-icons' %}
      {% endif %}
    </div>
  </div>
  <div class="footer-logo-band {{ section.settings.bg_color }} {{ section.settings.bg_gradient }}">
    <a class="footer-contact-logo" href="{{ routes.root_url }}">
      {% if footer_logo != blank %}
        <img src="{{ footer_logo | image_url: width: 2000 }}" alt="{{ shop.name | escape }}" width="{{ footer_logo.width }}" height="{{ footer_logo.height }}" loading="lazy">
      {% else %}
        <span>{{ shop.name | escape }}</span>
      {% endif %}
    </a>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "limit": 1,
  "settings": [
    { "type": "header", "content": "Contact" },
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "hello@lurevo.studio" },
    { "type": "link_list", "id": "collection_menu", "label": "Collections menu" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "header", "content": "Styling" },
    { "type": "select", "id": "bg_color", "label": "Background color", "default": "bg-secondary", "options": [
      { "value": "bg-secondary", "label": "Secondary" },
      { "value": "bg-body", "label": "Body" },
      { "value": "bg-white", "label": "White" }
    ] },
    { "type": "select", "id": "bg_gradient", "label": "Background gradient", "default": "bg-gradient", "options": [
      { "value": "bg-gradient", "label": "Yes" },
      { "value": "", "label": "No" }
    ] },
    { "type": "select", "id": "text_color", "label": "Text color", "default": "text-white", "options": [
      { "value": "text-white", "label": "White" },
      { "value": "text-body", "label": "Body" }
    ] },
    { "type": "range", "id": "pt", "label": "Top spacing", "min": 0, "max": 20, "step": 1, "default": 10 },
    { "type": "range", "id": "pb", "label": "Bottom spacing", "min": 0, "max": 20, "step": 1, "default": 7 }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
