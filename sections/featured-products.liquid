{% liquid
  assign feature_collection = collections[section.settings.collection]
  if feature_collection != blank and feature_collection.products_count > 0
    assign products = feature_collection.products
  else
    assign products = section.settings.products
  endif

  assign current_product_id = product.id
  assign feature_link = section.settings.feature_link | default: feature_collection.url | default: routes.all_products_collection_url
  assign feature_title = section.settings.feature_title | default: feature_collection.title | default: section.settings.header_title
  assign feature_image = section.settings.feature_image | default: feature_collection.image | default: products.first.featured_image

  assign recommendation_grid = false
  if section.settings.recommended_mode
    if request.page_type == 'product' or request.path contains 'recommendations'
      assign recommendation_grid = true
    endif
  endif

  assign show_recommendation_content = true
  if recommendation_grid
    assign show_recommendation_content = false
    if recommendations.performed? and recommendations.products_count > 0
      assign show_recommendation_content = true
    elsif collections.all.products_count > 1
      assign show_recommendation_content = true
    endif
  endif
%}

{% capture empty_state %}
  {% unless request.page_type == 'product' %}
    {% for num in (1..section.settings.limit) %}
      <div class="swiper-slide p-2 p-tablet-4 p-desktop-5">
        <div class="product-card text-center">
          {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
          {{ 'product-' | append: current | placeholder_svg_tag: 'product-card-img img-thumbnail mb-4' }}
          <h3 class="product-card-title h6 mb-1">
            Product {{ current }}
          </h3>
          <p class="mb-0">
            $19.99
          </p>
        </div>
      </div>
    {% endfor %}
  {% endunless %}
{% endcapture %}

{% if section.settings.recommended_mode and request.page_type == 'product' %}
<script>
  async function initProductRecommendations ()  {
    const sectionId = '{{ section.id }}'
    const baseUrl = '{{ routes.product_recommendations_url }}'
    const productId = {{ product.id }}
    const limit = Math.min({{ section.settings.limit }}, 10)
    const intent = '{{ section.settings.recommended_mode_intent }}'
    
    const url = `${baseUrl}?section_id=${sectionId}&product_id=${productId}&limit=${limit}&intent=${intent}`

    const response = await fetch(url)
    const data = await response.text()

    // console.log(url)
    // console.log(data)

    document.querySelector('#featured-products-{{ section.id }}')
      .closest('.shopify-section').outerHTML = data
  }

  window.addEventListener('DOMContentLoaded', () => {
    initProductRecommendations()
  })

  document.addEventListener('shopify:section:load', (e) => {
    if (e.target.querySelector('.featured-products')) {
      initProductRecommendations()
    }
  })  
</script>
{% endif %}

{% if recommendation_grid %}
  <div
    id="featured-products-{{ section.id }}"
    class="featured-products featured-products-recommendations {{ section.settings.bg_color }} {{ section.settings.bg_gradient }} {{ section.settings.text_color }} {{ section.settings.border_top_width | prepend: 'border-top-' }} {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }} {{ section.settings.border_color }} {{ section.settings.pt | prepend: 'pt-' }} {{ section.settings.pb | prepend: 'pb-' }}"
    style="--bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }}; --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};">
{% else %}
  <swiper-slider
    id="featured-products-{{ section.id }}"
    class="featured-products swiper-slider {{ section.settings.bg_color }} {{ section.settings.bg_gradient }} {{ section.settings.text_color }} {{ section.settings.border_top_width | prepend: 'border-top-' }} {{ section.settings.border_bottom_width | prepend: 'border-bottom-' }} {{ section.settings.border_color }} {{ section.settings.pt | prepend: 'pt-' }} {{ section.settings.pb | prepend: 'pb-' }}"
    style="--bs-bg-opacity: {{ section.settings.bg_opacity | append: '%' }}; --bs-border-opacity: {{ section.settings.border_opacity | append: '%' }};"
    data-section-id="{{ section.id }}"
    data-slider-speed="{{ section.settings.slider_speed }}"
    data-slider-navigation="{{ section.settings.slider_navigation }}"
    data-slider-pagination="{{ section.settings.slider_pagination }}"
    data-slider-scrollbar="{{ section.settings.slider_scrollbar }}"
    data-slider-autoplay="{{ section.settings.slider_autoplay }}"
    data-breakpoint-mobile="{{ section.settings.breakpoint_mobile }}"
    data-breakpoint-tablet="{{ section.settings.breakpoint_tablet }}"
    data-breakpoint-desktop="{{ section.settings.breakpoint_desktop }}">
{% endif %}
  <div 
    class="container"
    style="max-width: {{ section.settings.container_max_width | append: 'px' }};">
    {% if show_recommendation_content %}
      {% render 'section-header' %}
      <div class="featured-products-layout{% if request.page_type == 'index' and section.settings.show_feature_card %} has-promo{% endif %}">
        {% if recommendation_grid %}
          {% liquid
            assign shown_ids = '|' | append: current_product_id | append: '|'
            assign shown_count = 0
          %}
          <div class="featured-products-recommendation-grid">
            {% if recommendations.performed? and recommendations.products_count > 0 %}
              {% for recommended_product in recommendations.products %}
                {% assign product_marker = '|' | append: recommended_product.id | append: '|' %}
                {% unless shown_ids contains product_marker %}
                  <div class="featured-products-recommendation-item">
                    {% render 'product-card', product: recommended_product %}
                  </div>
                  {% assign shown_ids = shown_ids | append: product_marker %}
                  {% assign shown_count = shown_count | plus: 1 %}
                {% endunless %}
                {% if shown_count >= section.settings.limit %}{% break %}{% endif %}
              {% endfor %}
            {% endif %}
            {% if shown_count < section.settings.limit %}
              {% for fallback_product in collections.all.products %}
                {% assign product_marker = '|' | append: fallback_product.id | append: '|' %}
                {% unless shown_ids contains product_marker %}
                  <div class="featured-products-recommendation-item">
                    {% render 'product-card', product: fallback_product %}
                  </div>
                  {% assign shown_ids = shown_ids | append: product_marker %}
                  {% assign shown_count = shown_count | plus: 1 %}
                {% endunless %}
                {% if shown_count >= section.settings.limit %}{% break %}{% endif %}
              {% endfor %}
            {% endif %}
          </div>
        {% else %}
        {% if request.page_type == 'index' and section.settings.show_feature_card %}
          <a class="featured-products-promo" href="{{ feature_link }}">
            {% if feature_image %}
              {{ feature_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: feature_title }}
            {% endif %}
            <span class="featured-products-promo-content">
              <strong>{{ feature_title }}</strong>
              <span>{{ section.settings.feature_button_label | default: 'Xem ngay' }}</span>
            </span>
          </a>
        {% endif %}
      <div class="swiper mx-n2 mx-tablet-n4 mx-desktop-n5 mt-n3 mt-desktop-n5">
        <div class="swiper-wrapper">
          {% if products == blank %}
            {{ empty_state }}
          {% else %}
            {% for product in products limit: section.settings.limit %}
              <div class="swiper-slide p-2 p-tablet-4 p-desktop-5">
                {% render 'product-card', product: product %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
        <div class="swiper-controls">
          {% if section.settings.slider_pagination %}<div class="swiper-pagination"></div>{% endif %}
          {% if section.settings.slider_scrollbar %}<div class="swiper-scrollbar"></div>{% endif %}
          <div class="swiper-button-prev">
            {% render 'svg-icons', icon: 'chevron-left', size: 24 %}
          </div>
          <div class="swiper-button-next">
            {% render 'svg-icons', icon: 'chevron-right', size: 24 %}
          </div>
        </div>
      </div>
      {% endif %}
      </div>
      {% if recommendation_grid %}
        <div class="featured-products-view-all">
          <a href="{{ routes.all_products_collection_url }}">View all <span aria-hidden="true">›</span></a>
        </div>
      {% endif %}
      {% if request.page_type == 'index' and section.settings.show_view_all %}
        <div class="featured-products-view-all">
          <a href="{{ feature_link }}">{{ section.settings.view_all_label | default: 'Xem tất cả' }} <span aria-hidden="true">›</span></a>
        </div>
      {% endif %}
    {% endif %}
  </div>
{% if recommendation_grid %}</div>{% else %}</swiper-slider>{% endif %}

{% schema %}
{
