        "item_B99dNi": {
          "type": "item",
          "settings": {
            "title": "Perfect 40th birthday gift",
            "description": "<p>\"Ordered this for my husband's 40th birthday and it turned out better than I expected. The engraving was clean, the box looked gift-ready, and he actually opened it in front of everyone because he liked it so much.\"</p>",
            "customer_photo": "shopify://shop_images/iap_640x640.8171522772_9o5a7kz5.webp",
