        "item_XTUtYy": {
          "type": "item",
          "settings": {
            "title": "My dad loved the details",
            "description": "<p>\"Bought the police design for my dad after his retirement. He noticed the small details right away. It felt personal without being cheesy, which is exactly what I wanted.\"</p>",
            "customer_photo": "shopify://shop_images/iap_800x800.7287736470_s01qyz5i.webp",
            "author": "Jessica M.",
            "author_subtitle": "Verified Customer"
          }
        },
        "item_79nB3i": {
          "type": "item",
          "settings": {
            "title": "Helpful before production",
            "description": "<p>\"Customer service helped me fix a spelling mistake before production. That alone saved the gift. The finished set arrived packed well and my brother uses the glasses every weekend.\"</p>",
