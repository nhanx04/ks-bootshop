        "item_VPnR9Q": {
          "type": "item",
          "settings": {
            "title": "Better than the photos",
            "description": "<p>\"I was a little nervous about ordering something personalized online, but the preview matched what arrived. Shipping updates were clear and the decanter feels heavier and nicer than the photos showed.\"</p>",
