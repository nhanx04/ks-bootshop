            "author_subtitle": "Verified Customer"
          }
        },
        "item_BUkPE7": {
          "type": "item",
          "settings": {
            "title": "Looked expensive",
            "description": "<p>\"The family decanter set made our anniversary dinner feel extra special. The names were centered nicely and the wood box made it look much more expensive than it was.\"</p>",
            "customer_photo": "shopify://shop_images/iap_300x300.4461690900_9f30pqo9.webp",
            "author": "Rachel S.",
            "author_subtitle": "Verified Customer"
          }
        },
        "item_DtBFNc": {
          "type": "item",
          "settings": {
            "title": "Easy long-distance gift",
            "description": "<p>\"Sent this directly to my best friend, so I only saw photos after she opened it. Everything looked clean and classy, and she said it was one of the most thoughtful gifts she received.\"</p>",
