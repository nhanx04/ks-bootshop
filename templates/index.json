      "blocks": {
        "item_AgKJ3m": {
          "type": "item",
          "settings": {
            "title": "Can I use my own photo?",
            "description": "<p>Yes. Choose a product and send the photo you want personalized. Clear, well-lit photos with visible faces or details usually create the best result.</p>"
          }
        },
        "item_EemRD3": {
          "type": "item",
          "settings": {
            "title": "What can I personalize?",
            "description": "<p>Depending on the design, you can personalize photos, names, dates, titles, short messages, badges, career themes, family details, pet portraits, or hobby artwork.</p>"
          }
        },
        "item_jyLYkB": {
          "type": "item",
          "settings": {
            "title": "Is this a good gift for special occasions?",
            "description": "<p>Absolutely. These sets are designed for birthdays, weddings, anniversaries, retirements, Father's Day, Christmas, housewarmings, and milestone celebrations.</p>"
          }
        },
        "item_pHCJRG": {
          "type": "item",
          "settings": {
            "title": "How do I place an order?",
            "description": "<p>Pick the set you like, add your personalization details, then complete checkout. If you are unsure about the best design, contact us before ordering.</p>"
          }
        },
        "item_kWLWrb": {
          "type": "item",
          "settings": {
            "title": "Can I send it directly as a gift?",
            "description": "<p>Yes. Enter the recipient's shipping address at checkout. Use your own email so you receive the order updates and tracking information.</p>"
          }
        },
        "item_dizKmG": {
          "type": "item",
          "settings": {
            "title": "What if I need help choosing a photo?",
            "description": "<p>Send us a message with your idea and we can help you choose the right product, photo, wording, and design direction before you order.</p>"
          }
        }
